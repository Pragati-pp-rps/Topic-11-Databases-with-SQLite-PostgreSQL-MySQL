      "id": "06a864b3-f3c4-49f3-8522-bcae78dd4805",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH next_lead AS (\n    SELECT id\n    FROM public.order_leads\n    WHERE lead_status = 'pending'\n    ORDER BY id ASC\n    LIMIT 1\n    FOR UPDATE SKIP LOCKED\n)\nUPDATE public.order_leads AS ol\nSET\n    lead_status = 'processing',\n    updated_at = NOW()\nFROM next_lead\nWHERE ol.id = next_lead.id\nRETURNING\n    ol.id,\n    ol.customer_email,\n    ol.customer_name,\n    ol.product,\n    ol.quantity,\n    ol.lead_status;\n\n",
        "options": {}
      },
      "id": "30b946cf-294a-42c3-ab97-f5b756a08b5d",
      "name": "SQL_FetchAndLockRow",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        0
      ],
      "alwaysOutputData": false,
      "credentials": {
        "postgres": {
          "id": "TCpwyMALQ2hX4Vct",
          "name": "Pragati Postgres"
        }
      },
      "notes": "Atomically selects ONE pending lead using FOR UPDATE SKIP LOCKED and flips it to 'processing' in the same statement, so concurrent executions never grab the same row."
    },
    {
      "parameters": {
        "jsCode": "// ACTION_ProcessOrder: business logic placeholder for the locked order lead\nconst results = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n\n  results.push({\n    json: {\n      ...lead,\n      customer_email: String(lead.customer_email || '').trim().toLowerCase(),\n      customer_name: String(lead.customer_name || '').trim(),\n      processed_at: new Date().toISOString(),\n      process_result: `Order for ${lead.quantity} x ${lead.product} processed`\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "9f0b205d-9a96-419e-bd39-5052fe851d2a",
      "name": "ACTION_ProcessOrder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        0
      ],
      "notes": "Normalises email (lowercase/trim) so the upsert key is consistent, and performs order processing logic."
    },
